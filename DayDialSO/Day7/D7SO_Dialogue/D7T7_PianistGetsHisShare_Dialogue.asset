  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D7T7_PianistGetsHisShare_Dialogue
  m_EditorClassIdentifier: 
  npc: 28
  sequence:
  - dialogueText: Back from the beach? Don't tell me... the sea actually coughed
      up the goods?
    buttonText: Here's your share
  - dialogueText: Damn... you really found them? I can't believe it.
    buttonText: Three for you
  - dialogueText: Thank you. I'm rich... finally. I can leave this place behind and
      find a piano that actually works.
    buttonText: A real place?
  - dialogueText: Somewhere with lights, air, and no sand in the keys. I'm finally
      playing a real show.
    buttonText: Goodbye, then
  - dialogueText: Goodbye, kiddo. And thanks for these pretty rocks. Hey, by the
      way...
    buttonText: What?
  - dialogueText: The Boss is waving at you. You've got a finale to play, right?
    buttonText: Yeah...
