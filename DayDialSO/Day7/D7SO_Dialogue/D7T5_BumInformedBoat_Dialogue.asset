MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D7T5_BumInformedBoat_Dialogue
  m_EditorClassIdentifier: 
  npc: 4
  sequence:
  - dialogueText: Strong stuff. Like liquid lightning.
    buttonText: Got a boat
  - dialogueText: Heh, I knew it. Something told me you'd be the one to finally cheat
      the game.
    buttonText: No time
  - dialogueText: Time? Time isn't real. You want to see if the path through the
      fog still exists?
    buttonText: Meet me tonight
  - dialogueText: The deck. The main deck. I'll be your eyes, if the stars don't
      fall first.
    buttonText: Be there
  - dialogueText: I will. But listen close. If you have any unfinished business,
      bury it now.
    buttonText: Why?
  - dialogueText: Because once we push off, the island stops being real. There is
      no coming back.
    buttonText: I'll keep that in mind
  - dialogueText: Good. Go make your peace with the Tavern. I'll see you when the
      time comes.
    buttonText: See you then
