MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D7T3_LadyInformedAboutBoat_Dialogue
  m_EditorClassIdentifier: 
  npc: 36
  sequence:
  - dialogueText: You're looking tense. You usually wear that mask better. Something
      go sour?
    buttonText: Got a boat
  - dialogueText: Keep your voice down. You're sure about that?
    buttonText: It's ready
  - dialogueText: People on this island don't just "get" boats. They can't deck here,
      remember?
    buttonText: No time
  - dialogueText: You're right. The air feels heavy enough. What's the plan?
    buttonText: Meet me tonight
  - dialogueText: On the deck? That's suicide. The Boss is watching everyone tonight.
    buttonText: He won't be a problem
  - dialogueText: God... you're really doing it. Okay. If I'm not there by closing,
      don't wait for me
    buttonText: Just be there
  - dialogueText: I'll try. See you on... the other side, I guess.
    buttonText: Don't be late
