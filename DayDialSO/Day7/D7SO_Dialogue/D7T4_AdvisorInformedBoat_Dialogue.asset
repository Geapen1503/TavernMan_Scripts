--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D7T4_AdvisorInformedBoat_Dialogue
  m_EditorClassIdentifier: 
  npc: 0
  sequence:
  - dialogueText: You're pushing your luck. This isn't your usual shift behavior.
    buttonText: Got a boat
  - dialogueText: Keep that tone steady. You've lost your mind?
    buttonText: No time
  - dialogueText: A boat doesn't just appear on the island. What did you trade for
      it? And don't lie to me.
    buttonText: Doesn't matter now
  - dialogueText: It matters if we end up at the bottom of the bay. Who's running
      the engine?
    buttonText: You
  - dialogueText: You're betting everything on a single turn of the card. It's reckless.
    buttonText: Meet me tonight
  - dialogueText: The deck? That's a suicide mission, we'll be busted in a heartbeat.
    buttonText: Be there
  - dialogueText: I've spent months figuring out the patterns here. If you're really
      leaving, I'll be there.
    buttonText: Closing time
  - dialogueText: If I'm not there, assume the worst and go.
    buttonText: Sure
