  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D7T11_InformBumBoat_Dialogue
  m_EditorClassIdentifier: 
  npc: 4
  sequence:
  - dialogueText: Wind is shifting south. Perfect tide for a clean escape.
    buttonText: It's time
  - dialogueText: I'm ready. The currents are quiet tonight, we won't even have to
      fight the waves.
    buttonText: Boat's ready
  - dialogueText: Good. I'll keep my eyes on the water. I know the blind spots of
      this bay
    buttonText: Head to deck
  - dialogueText: I'll slip out. What's the cue?
    buttonText: Watch the door
  - dialogueText: Got it. When you walk out, I'm right behind you.
    buttonText: See you there
