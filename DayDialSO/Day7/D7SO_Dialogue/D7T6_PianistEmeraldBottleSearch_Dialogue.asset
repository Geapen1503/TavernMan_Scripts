  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D7T6_PianistEmeraldBottleSearch_Dialogue
  m_EditorClassIdentifier: 
  npc: 28
  sequence:
  - dialogueText: You're rushing the tempo tonight, kiddo.
    buttonText: Regular work
  - dialogueText: If you say so... But I have a strong belief the sea finally gave
      up our green bottle
    buttonText: No time
  - dialogueText: Don't drop the rhythm. We're so close to the finale, I can feel
      those emeralds in my fingers.
    buttonText: It's total bullshit.
  - dialogueText: One more time. Just a quick walk to the water. And I'll give you
      my lucky quarter if I'm wrong.
    buttonText: A lucky quarter? Yeah...
  - dialogueText: It never failed me. If the sand is empty, the coin is yours. Just
      go check.
    buttonText: Fine. Still bullshit.
