  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D7T13_BossGoodbyeDrink_Dialogue
  m_EditorClassIdentifier: 
  npc: 33
  sequence:
  - dialogueText: My throat is drier than a mexican's boot. We need a proper toast
      to end this.
    buttonText: What's the drink?
  - dialogueText: Bring up two glasses of that undersea whiskey we dredged up.
    buttonText: The expensive one?
  - dialogueText: The very same. One for me, one for you. And don't spill a drop.
    buttonText: Pouring it now
