  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D7T14_BossGoodbye_Dialogue
  m_EditorClassIdentifier: 
  npc: 33
  sequence:
  - dialogueText: Ah... hits the chest like a lead bullet.
    buttonText: Worth the trouble
  - dialogueText: It always is. Now, what's with that look? You've got that "ready
      to jump" twitch in your legs.
    buttonText: I'm leaving tonight
  - dialogueText: Go on then. But don't think you're packing light. You still have
      those missing crates on your conscience. T -Still looking?
    buttonText: Next
  - dialogueText: Never had to look. The thief was serving me drinks and sweeping
      my floors the entire time.
    buttonText: Why stay quiet?
  - dialogueText: Doesn't matter now, does it? But at least, one thing is sure. That
      is a tasty liquid.
    buttonText: Come with us
  - dialogueText: I appreciate the offer, TavernMan. But no.
    buttonText: Why?
  - dialogueText: It's a bold play, trying to beat the game. I respect that. But
      a captain sinks with his ship.
    buttonText: This Tavern?
  - dialogueText: Yes, this Tavern, I like the rent here. You did a great job. Thanks
      for the service. Now get out.
    buttonText: Goodbye
