  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D7T9_BossCleanFloor_Dialogue
  m_EditorClassIdentifier: 
  npc: 33
  sequence:
  - dialogueText: That's a weight off our chests. Now clean that floor, and we're
      good for tonight.
    buttonText: Almost done
  - dialogueText: Make it spotless. I've seen enough blood on these boards to last
      a lifetime.
    buttonText: Understood
  - dialogueText: Then we're good for tonight.
    buttonText: Rest of the night?
  - dialogueText: Take it. Then stay out of sight. I've got a tavern to run and a
      blind eye to turn.
    buttonText: I'm gone
