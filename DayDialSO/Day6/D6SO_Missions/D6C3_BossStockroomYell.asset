  missionState: 0
  missionDescription: 
  startDelay: 0.8
  showPrefix: 0
  dialogueSequence:
  - text: 'Boss : The fuck did you do?! The hell! Why did you do that?!'
    duration: 5
    pauseAfterDuration: 1.1
  - text: 'Boss : Don''t answer. I don''t give a damn who paid you. It doesn''t matter
      anymore.'
    duration: 6
    pauseAfterDuration: 1.3
  - text: 'Boss : It reminds me of the damn stonefish... Shit! Not the time! Think,
      think, think...'
    duration: 5.9
    pauseAfterDuration: 1.2
  - text: 'Boss : We''re in deep shit, you degenerate. We''re both dead men walking
      now. Both of us!'
    duration: 6.8
    pauseAfterDuration: 1.5
  - text: 'Boss : We need to get rid of this prick. Right now.'
    duration: 4
    pauseAfterDuration: 1
  - text: 'Boss : Get the fuck outta my stockroom. Get out of my sight. We''ll talk
      later. Move!'
    duration: 5.7
    pauseAfterDuration: 0
