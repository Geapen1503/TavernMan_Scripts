  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D6T3_BossAfterCleaning_Dialogue
  m_EditorClassIdentifier: 
  npc: 33
  sequence:
  - dialogueText: Not bad... I can almost see my boots in the wood. The parrotfish
      could be jealous.
    buttonText: Finally clean
  - dialogueText: Alright, take a breath. The calm before the storm. Go waste some
      time, do whatever it is you do.
    buttonText: Just wait?
  - dialogueText: Kill time, wander around, stretch those legs. I'll give you a shout
      when our mystery ship docks.
    buttonText: Catch you later then
