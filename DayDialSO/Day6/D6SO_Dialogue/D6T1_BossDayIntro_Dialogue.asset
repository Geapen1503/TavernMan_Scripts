  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D6T1_BossDayIntro_Dialogue
  m_EditorClassIdentifier: 
  npc: 33
  sequence:
  - dialogueText: Look at that... Six nights in this dump. Six. That's the devil's
      dozen around here.
    buttonText: Still standing
  - dialogueText: Barely. Remember yesterday? Cleaning the floors, making the place
      look all pretty for a special guest?
    buttonText: For who?
  - dialogueText: Fresh meat, kid. A new face is dropping by tonight. You're gonna
      be his welcoming committee.
    buttonText: Right now?
  - dialogueText: Nah, he'll drift in later. But you're right about one thing...
      we need to prep the room
    buttonText: How?
  - dialogueText: Hearing that? The customers are too loud. Heavy pockets, loose
      tongues. We need them quiet before our guest arrives.
    buttonText: Shush them?
  - dialogueText: Exactly. Put a cork in it. Go serve Bourbon to the Scot, the poker
      whelks, and that miserable farmer.
    buttonText: Cheap anesthesia
  - dialogueText: Move it. A drowned tongue is a silent tongue. Let's make this place
      look respectable.
    buttonText: Pouring begins
