  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D6T14_BossAfterPlayerKill_Dialogue
  m_EditorClassIdentifier: 
  npc: 33
  sequence:
  - dialogueText: Back so soon? Where is he?
    buttonText: Nobody there
  - dialogueText: What do you mean, there was nobody? The ship signaled its approach.
    buttonText: Deck's empty
  - dialogueText: Empty... right. He must be running late then. Though... that man
      is never late. Not for this.
    buttonText: Maybe a delay
  - dialogueText: Yeah. A delay. Let's go with that for now.
    buttonText: Should I wait?
  - dialogueText: Whatever. Go wander around for a bit, get out of my sight. I'll
      call you when he's back. If he's back.
    buttonText: Fine by me
