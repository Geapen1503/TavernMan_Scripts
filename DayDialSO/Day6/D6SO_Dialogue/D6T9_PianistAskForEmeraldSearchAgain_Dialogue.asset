  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D6T9_PianistAskForEmeraldSearchAgain_Dialogue
  m_EditorClassIdentifier: 
  npc: 28
  sequence:
  - dialogueText: You handled your business with the Boss?
    buttonText: It's done
  - dialogueText: Good. Now we can finally focus back on our little treasure hunt.
    buttonText: The bottle...
  - dialogueText: Exactly. I have a feeling about tonight, kiddo. The air feels right.
      It's out there on the sand, waiting.
    buttonText: Hope so
  - dialogueText: Tell you what, let's celebrate early. Pour me a glass of whiskey
      first, what do you say?
    buttonText: Charlatan
  - dialogueText: Ouch. An artist needs inspiration, kiddo. Think of it as a down
      payment for my intuition
    buttonText: Just free booze
  - dialogueText: Call it what you want, but a dry throat never found an emerald.
      Chop chop.
    buttonText: On it
  - dialogueText: Perfect. Once my throat is dry no more, you can head straight to
      the beach and find those green rocks.
    buttonText: Deal
