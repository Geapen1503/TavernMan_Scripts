  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D6T12_TellBumAboutBoat_Dialogue
  m_EditorClassIdentifier: 
  npc: 4
  sequence:
  - dialogueText: Cool night again, right? The air feels quiet, like it's waiting
      for a storm.
    buttonText: We have a deal
  - dialogueText: Really? For that specific transportation we discussed?
    buttonText: By tomorrow
  - dialogueText: Tomorrow already... That's fast. Are you sure everything is lined
      up?
    buttonText: We need a guide
  - dialogueText: I told you, I'm in. I still know the way out through the currents
    buttonText: Just as plan
  - dialogueText: Just say the word and I'll meet you there. I won't back down.
    buttonText: Stay discreet
  - dialogueText: Don't worry, my lips are sealed. Go finish your shift, I'll be
      waiting.
    buttonText: Tomorrow then
