  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D6T16_AdvisorAfterPlayerKill_Dialogue
  m_EditorClassIdentifier: 
  npc: 0
  sequence:
  - dialogueText: Tell me you have good news. Did you handle it?
    buttonText: It's done
  - dialogueText: And the Indian? Are we still on track?
    buttonText: Boat next night
  - dialogueText: Next night... Damn, it's actually happening. But I don't know...
      Man
    buttonText: What about it
  - dialogueText: It just seems too easy. Someone might be double-crossing us.
    buttonText: We're fine
  - dialogueText: Look... Damn it. Look at the Boss right now. He's absolutely enraged.
      Go talk to him
    buttonText: He's enraged?
  - dialogueText: Act natural. But before you step over there... if things escalate...
      I'm going to need a whisky.
    buttonText: Getting nervous?
  - dialogueText: Just pour the drink. It will make this interaction look completely
      normal
    buttonText: Pouring's coming
