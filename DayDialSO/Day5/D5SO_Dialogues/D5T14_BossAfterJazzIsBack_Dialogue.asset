  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D5T14_BossAfterJazzIsBack_Dialogue
  m_EditorClassIdentifier: 
  npc: 33
  sequence:
  - dialogueText: Aaaaaah... listen to that. Jazz, again and again. It's like a warm
      bath for the soul.
    buttonText: It's back
  - dialogueText: Over and over again... Just like the world... Back then. Music
      with a pulse, not that tropical fever.
    buttonText: Perfection?
  - dialogueText: Absolutely. Now I can actually hear the coins clinking in my head.
    buttonText: What's next
  - dialogueText: We're closing in on the end of the night. Let's do the last service
      before this darkness gets any heavier.
    buttonText: Who's hungry?
  - dialogueText: Go feed the mountain of muscles in the linen wrap, the man with
      the shinny head, and the lawman.
    buttonText: The usual?
  - dialogueText: The only meal we can cook. Just make sure they're fed and happy.
      I don't want any complaints during the witching hour.
    buttonText: I'm on it
