  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D5T8_LadyAfterPlaylistChange_Dialogue
  m_EditorClassIdentifier: 
  npc: 36
  sequence:
  - dialogueText: Finally. A bit of rhythm. This time it doesn't feel like we're
      waiting for the rain to start
    buttonText: Better?
  - dialogueText: Way better. I was starting to feel like I was about to perform
      at a wake.
    buttonText: Boss's idea
  - dialogueText: For once, he had a good one. It's a nice change, I thought he'll
      never buy them
    buttonText: I was right
  - dialogueText: I stand corrected. I really didn't think you'd pull it off, especially
      after the way you started at that table
    buttonText: It worked
  - dialogueText: It did, by the way, the guy on the keys was looking for you.
    buttonText: The Pianist?
  - dialogueText: Yeah. He kept nodding your way while you were at the jukebox. Go
      see what he wants.
    buttonText: I'll go
