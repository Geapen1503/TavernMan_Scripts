  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D5T7_BossAfterPlaylistChange_Dialogue
  m_EditorClassIdentifier: 
  npc: 33
  sequence:
  - dialogueText: Listen to that! Finally, a rhythm that doesn't sound like a funeral
      in a swamp.
    buttonText: Better now?
  - dialogueText: It's got some sugar in it. My ears are finally stopping their strike.
    buttonText: Good music
  - dialogueText: It's a start. Now, take those heavy boots elsewhere for a while.
    buttonText: I'm done?
  - dialogueText: Go find a hammock or go talk to the coconuts. I'm done looking
      at you.
    buttonText: I'll rest
  - dialogueText: If you want, yes. But don't go falling into a deep sleep. We're
      still early in the night and there's more to come.
    buttonText: More later?
  - dialogueText: Much more, now go. And Try not to dream of poker. Your wallet can't
      take another nightmare.
    buttonText: I'm off
