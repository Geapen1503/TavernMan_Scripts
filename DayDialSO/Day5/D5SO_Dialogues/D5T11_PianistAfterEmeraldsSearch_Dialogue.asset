  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D5T11_PianistAfterEmeraldsSearch_Dialogue
  m_EditorClassIdentifier: 
  npc: 28
  sequence:
  - dialogueText: So, you're back? Did you find anything on the beach
    buttonText: Nothing but sand
  - dialogueText: The ocean doesn't play on cue, kiddo. It's not a jukebox.
    buttonText: Waste of time
  - dialogueText: Only if you stop looking. You just have to search the beach every
      night. Eventually, the sand will pay its debt.
    buttonText: Three stones for a maybe
  - dialogueText: Luck is just being there when the wave hits. Keep checking every
      night. It'll turn up.
    buttonText: It better
