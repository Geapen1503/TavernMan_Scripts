  m_Script: {fileID: 11500000, guid: 512a72de08c75cf4e8a8424f7b75a271, type: 3}
  m_Name: D5T17_BossAfterSecondMop_Dialogue
  m_EditorClassIdentifier: 
  npc: 33
  sequence:
  - dialogueText: Done? Fantastic. I can actually see the clouds in the floorboards.
      It's almost as smooth as a saxophone solo.
    buttonText: It's done
  - dialogueText: Then your service is finally over for tonight. You're free to go.
      Go do whatever you want.
    buttonText: Really?
  - dialogueText: Within reason. Go talk to the waves or count the stars... I don't
      care. Just don't you dare put any dirt back on this floor.
    buttonText: I'm leaving
  - dialogueText: Good. I've seen enough of your face for one night anyway. Try not
      to trip over your own feet on your way out.
    buttonText: Likewise
